# ローカル開発ではこのファイルを.env.localへ複製して値を設定する。
# デプロイ先の値は`pnpm exec wrangler secret put <NAME> --env <ENVIRONMENT>`で登録する。

# Better Authのcookie・OAuth token暗号化に使うversioned secrets。
# `<version>:<secret>`をカンマ区切りで並べ、先頭をcurrentにする（例: `2:新しい値,1:古い値`）。
# 値は`openssl rand -base64 32`などで32文字以上の乱数を生成する。
BETTER_AUTH_SECRETS=

# Google OAuthのクライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuthのクライアント
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ORCID（Generic OAuth）のクライアント
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# staging・PreviewのBasic認証の資格情報。デプロイ先のSecretだけに登録する。
# ビルド環境に設定すると、ビルド時のSPA shell事前生成がBasic認証で拒否されるため、ローカルとCIのビルドでは空にする。
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
