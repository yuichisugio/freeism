# ローカル開発ではこのファイルを.env.localへ複製して値を設定する。
# デプロイ先の値は`pnpm exec wrangler secret put <NAME> --env <ENVIRONMENT>`で登録する。

# Better Authのcookie・token暗号化に使う秘密値
BETTER_AUTH_SECRET=

# Google OAuthのクライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuthのクライアント
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ORCID（Generic OAuth）のクライアント
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# staging・PreviewのBasic認証の資格情報。デプロイ先のSecretだけに登録する。
# ビルド環境に設定すると、ビルド時のSPA shell事前生成がBasic認証で拒否されるため、ローカルとCIのビルドでは空にする。
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
