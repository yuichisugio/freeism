{
  "name": "@freeism/markets-web-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "preview": "vp preview --host 127.0.0.1 --port 4173",
    "check": "vp check",
    "test": "vp test run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test -c playwright.config.ts",
    "build": "vp build",
    "build:staging": "CLOUDFLARE_ENV=staging vp build && node scripts/generate-static-security-headers.mjs . staging",
    "build:production": "CLOUDFLARE_ENV=production vp build && node scripts/generate-static-security-headers.mjs . production",
    "build:assert": "node scripts/assert-worker-build.mjs .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:staging": "node scripts/migrate-d1.mjs staging",
    "db:migrate:production": "node scripts/migrate-d1.mjs production",
    "deploy:staging": "node scripts/deploy-generated.mjs staging",
    "deploy:production": "node scripts/deploy-generated.mjs production",
    "types:worker": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.28",
    "jose": "6.2.3",
    "oauth4webapi": "3.8.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.2",
    "@cloudflare/vitest-pool-workers": "0.18.2",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/snapshot": "4.1.10",
    "@vitest/utils": "4.1.10",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.10",
    "happy-dom": "20.10.6",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "4.1.10",
    "wrangler": "4.108.0"
  }
}
