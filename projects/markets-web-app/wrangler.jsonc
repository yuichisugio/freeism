{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auction-worker",
  "main": "./src/server.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": [
    "nodejs_compat",
    "assets_navigation_has_no_effect",
    "global_fetch_strictly_public",
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "APP_HOST": "localhost",
    "APP_ORIGIN": "http://localhost:3001",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRETS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
  },
  "d1_databases": [{ "binding": "DB", "migrations_dir": "drizzle" }],
  "durable_objects": {
    "bindings": [{ "name": "AUCTION_ROOMS", "class_name": "AuctionRoom" }],
  },
  "workflows": [
    {
      "name": "auction-settlement-local",
      "binding": "AUCTION_SETTLEMENT",
      "class_name": "AuctionSettlementWorkflow",
      "limits": { "steps": 25000 },
    },
  ],
  "limits": { "cpu_ms": 300000, "subrequests": 10000000 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "migrations": [{ "tag": "auction-room-v1", "new_sqlite_classes": ["AuctionRoom"] }],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/.well-known/*"],
  },
  "env": {
    "staging": {
      "name": "auction-worker-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "APP_HOST": "staging.markets.freeism.app",
        "APP_ORIGIN": "https://staging.markets.freeism.app",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRETS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
      },
      "d1_databases": [{ "binding": "DB", "migrations_dir": "drizzle" }],
      "durable_objects": {
        "bindings": [{ "name": "AUCTION_ROOMS", "class_name": "AuctionRoom" }],
      },
      "workflows": [
        {
          "name": "auction-settlement-staging",
          "binding": "AUCTION_SETTLEMENT",
          "class_name": "AuctionSettlementWorkflow",
          "limits": { "steps": 25000 },
        },
      ],
      "limits": { "cpu_ms": 300000, "subrequests": 10000000 },
      "triggers": { "crons": ["*/5 * * * *"] },
      "migrations": [{ "tag": "auction-room-v1", "new_sqlite_classes": ["AuctionRoom"] }],
      "routes": [{ "pattern": "staging.markets.freeism.app", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 },
      },
    },
    "production": {
      "name": "auction-worker-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "APP_HOST": "markets.freeism.app",
        "APP_ORIGIN": "https://markets.freeism.app",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRETS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
      },
      "d1_databases": [{ "binding": "DB", "migrations_dir": "drizzle" }],
      "durable_objects": {
        "bindings": [{ "name": "AUCTION_ROOMS", "class_name": "AuctionRoom" }],
      },
      "workflows": [
        {
          "name": "auction-settlement-production",
          "binding": "AUCTION_SETTLEMENT",
          "class_name": "AuctionSettlementWorkflow",
          "limits": { "steps": 25000 },
        },
      ],
      "limits": { "cpu_ms": 300000, "subrequests": 10000000 },
      "triggers": { "crons": ["*/5 * * * *"] },
      "migrations": [{ "tag": "auction-room-v1", "new_sqlite_classes": ["AuctionRoom"] }],
      "routes": [{ "pattern": "markets.freeism.app", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 },
      },
    },
  },
}
