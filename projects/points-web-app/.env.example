# ローカル開発ではこのファイルを.env.localへ複製して値を設定する。
# デプロイ先の値は`pnpm exec wrangler secret put <NAME> --env <ENVIRONMENT>`で登録する。

# Better Authのcookie・OAuth token暗号化に使うversioned secrets。
# `<version>:<secret>`をカンマ区切りで並べ、先頭をcurrentにする。32文字以上。
# `printf '1:%s\n' "$(openssl rand -base64 48)"`
BETTER_AUTH_SECRETS=

# Google OAuthのクライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuthのクライアント
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Accounts接続の秘密鍵を暗号化するKEK。`openssl rand -base64 32`
ACCOUNTS_KEY_ENCRYPTION_KEY=

# staging・PreviewのBasic認証の資格情報。デプロイ先のSecretだけに登録する。
# ビルド環境に設定すると、ビルド時のSPA shell事前生成がBasic認証で拒否されるため、ローカルとCIのビルドでは空にする。
STAGING_BASIC_AUTH_USERNAME=
STAGING_BASIC_AUTH_PASSWORD=
