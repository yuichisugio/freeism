{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "points-worker",
  "main": "./src/server.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": [
    "nodejs_compat",
    "assets_navigation_has_no_effect",
    "global_fetch_strictly_public",
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ENV": "local",
    "APP_HOST": "localhost",
    "APP_ORIGIN": "http://localhost:3000",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRETS",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "INITIAL_ADMIN_GOOGLE_ACCOUNT_ID",
    ],
  },
  "d1_databases": [{ "binding": "DB", "migrations_dir": "drizzle" }],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/.well-known/*"],
  },
  "env": {
    "staging": {
      "name": "points-worker-staging",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "APP_HOST": "staging.points.freeism.app",
        "APP_ORIGIN": "https://staging.points.freeism.app",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRETS",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "INITIAL_ADMIN_GOOGLE_ACCOUNT_ID",
        ],
      },
      "routes": [{ "pattern": "staging.points.freeism.app", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 },
      },
    },
    "production": {
      "name": "points-worker-production",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "APP_ENV": "production",
        "APP_HOST": "points.freeism.app",
        "APP_ORIGIN": "https://points.freeism.app",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRETS",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "INITIAL_ADMIN_GOOGLE_ACCOUNT_ID",
        ],
      },
      "routes": [{ "pattern": "points.freeism.app", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 },
      },
    },
  },
}
