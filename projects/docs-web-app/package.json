{
	"name": "docs-web-app",
	"version": "2.1.0",
	"private": true,
	"description": "無料主義の仕様を記載したリポジトリ",
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuichisugio/freeism-documentation.git"
	},
	"scripts": {
		"dev": "pnpm --filter @freeism/legacy-typescript-tools run docs:dev",
		"check": "pnpm --filter @freeism/legacy-typescript-tools run docs:check",
		"test": "vitest run --passWithNoTests",
		"build": "pnpm --filter @freeism/legacy-typescript-tools run docs:build",
		"deploy:staging": "wrangler deploy --env staging",
		"deploy:production": "wrangler deploy --env production",
		"smoke:staging": "node ../../scripts/sites/smoke-static-site.mjs --url https://staging.docs.freeism.app/ --canonical https://docs.freeism.app/ --text \"無料主義 v3\" --link https://staging.docs.freeism.app/en/ --link https://staging.docs.freeism.app/notes",
		"smoke:production": "node ../../scripts/sites/smoke-static-site.mjs --url https://docs.freeism.app/ --canonical https://docs.freeism.app/ --text \"無料主義 v3\" --link https://docs.freeism.app/en/ --link https://docs.freeism.app/notes",
		"lint:fix": "pnpm exec textlint --fix src/readme/README.ja.md && pnpm exec textlint --fix src/freeism.ja.md",
		"lint": "pnpm exec textlint src/readme/README.ja.md && pnpm exec textlint src/freeism.ja.md",
		"lint-staged": "lint-staged"
	},
	"keywords": [],
	"devDependencies": {
		"@astrojs/mdx": "^7.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"astro": "^7.0.9",
		"blume": "^1.0.3",
		"husky": "^5.0.0-alpha.6",
		"lint-staged": "^15.3.0",
		"@textlint-ja/textlint-rule-no-insert-dropping-sa": "^1.0.1",
		"textlint": "^11.6.3",
		"textlint-filter-rule-comments": "^1.2.2",
		"textlint-filter-rule-whitelist": "^2.0.0",
		"textlint-rule-abbr-within-parentheses": "^1.0.2",
		"textlint-rule-footnote-order": "^1.0.3",
		"textlint-rule-general-novel-style-ja": "^1.3.0",
		"textlint-rule-ja-hiragana-fukushi": "^1.2.0",
		"textlint-rule-ja-hiragana-hojodoushi": "^1.0.4",
		"textlint-rule-ja-hiragana-keishikimeishi": "^1.0.2",
		"textlint-rule-ja-unnatural-alphabet": "^2.0.1",
		"textlint-rule-ng-word": "^1.0.0",
		"textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
		"textlint-rule-period-in-list-item": "^0.3.2",
		"textlint-rule-prefer-tari-tari": "^1.0.3",
		"textlint-rule-preset-ja-spacing": "^2.0.2",
		"textlint-rule-preset-ja-technical-writing": "^3.1.3",
		"textlint-rule-prh": "^5.3.0",
		"textlint-rule-spellcheck-tech-word": "^5.0.0",
		"typescript": "7.0.2",
		"vitest": "^3.2.4",
		"wrangler": "4.108.0"
	},
	"author": "yuichisugio",
	"license": "ISC",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/yuichisugio/freeism-documentation/issues"
	},
	"homepage": "https://github.com/yuichisugio/freeism-documentation#readme"
}
