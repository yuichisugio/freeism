---
import { getEntry, render } from "astro:content";
import BlumePage from "blume/components/BlumePage.astro";
import RootLayout from "blume/components/layout/RootLayout.astro";
import data from "blume:data";
import { getBlumeCollection } from "blume/runtime";

interface Props {
  description: string;
  locale: "ja" | "en";
  localePaths: Record<"ja" | "en", string>;
  publicPath: string;
  sourcePath: string;
}

const { description, locale, localePaths, publicPath, sourcePath } = Astro.props;
const contentRoute = getBlumeCollection(data, {
  collection: "staged",
  locale,
}).find((route) => route.path === sourcePath);

if (!contentRoute) {
  throw new Error(`Canonical Blume content route not found: ${sourcePath}`);
}

const entry = await getEntry("staged", contentRoute.entryId);
if (!entry) {
  throw new Error(`Canonical Blume content entry not found: ${contentRoute.entryId}`);
}

const { headings } = await render(entry);
const navigation = data.navigationByLocale[locale] ?? data.navigation;
const ui = data.uiByLocale[locale] ?? data.ui;
const localeSwitch = (data.config.i18n?.locales ?? []).map((configuredLocale) => ({
  code: configuredLocale.code,
  current: configuredLocale.code === locale,
  dir: configuredLocale.dir,
  href: localePaths[configuredLocale.code as "ja" | "en"],
  label: configuredLocale.label,
  untranslated: false,
}));
const site = {
  title: data.config.title,
  description: data.config.description,
};
const canonical = data.config.site
  ? `${data.config.site.replace(/\/$/u, "")}${publicPath === "/" ? "" : publicPath}`
  : null;
---

<RootLayout
  analytics={data.config.analytics}
  appleIcon={data.config.appleIcon}
  banner={data.config.banner}
  canonical={canonical}
  codeWrap={data.config.codeWrap}
  contentDir="ltr"
  dir="ltr"
  favicon={data.config.favicon}
  fontCssVars={data.fontCssVars}
  headings={headings}
  imageZoom={data.config.imageZoom}
  indexable={true}
  locale={locale}
  localeSwitch={localeSwitch}
  logo={data.config.logo}
  navigation={navigation}
  page={{ title: contentRoute.title, description, route: publicPath }}
  searchEnabled={data.config.search.enabled}
  site={site}
  siteUrl={data.config.site}
  structuredDataEnabled={data.config.structuredData}
  themeMode={data.config.theme.mode}
  toc={data.config.toc}
  ui={ui}
>
  <BlumePage collection="staged" id={contentRoute.entryId} />
</RootLayout>

<style is:global>
  .prose {
    overflow-wrap: anywhere;
  }

  .prose li > p:has(+ :where(ul, ol)) {
    margin-bottom: 0;
  }

  .prose li > :where(ul, ol) {
    margin-block: 0;
  }

  .prose pre {
    max-width: 100%;
    overflow-x: auto;
  }

  .prose pre code {
    width: max-content;
    min-width: 100%;
    overflow: visible;
  }

  .canonical-mermaid > div {
    min-width: 100%;
  }

  .canonical-mermaid svg {
    display: block;
    width: 125% !important;
    max-width: none !important;
    height: auto;
  }
</style>

<script>
  import { normalizeMermaidSource } from "../normalize-mermaid-source";

  for (const codeBlock of document.querySelectorAll<HTMLPreElement>(".prose pre[data-language]")) {
    if (codeBlock.dataset.language?.toLowerCase() !== "mermaid") {
      continue;
    }

    const source = codeBlock.querySelector("code")?.textContent;
    if (!source) {
      continue;
    }

    const diagram = document.createElement("blume-mermaid");
    diagram.className = "canonical-mermaid not-prose my-6 flex justify-center overflow-x-auto";
    diagram.dataset.source = normalizeMermaidSource(source);
    codeBlock.replaceWith(diagram);
  }
</script>
